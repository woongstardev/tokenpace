# Response headers for Cloudflare Workers static assets (and Pages, same format).
#
# The <meta> CSP in index.html is the fallback for anyone serving these files
# some other way. This is the real one — it can carry frame-ancestors, which a
# meta tag cannot.
#
# The policy is deliberately absolute: this site loads nothing from anywhere.
# No fonts, no analytics, no CDN. If a future change needs an exception, that
# exception is the thing to argue about, not this file.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# The measurement documents and the licences are meant to be read. Served as
# text/markdown a browser downloads them instead of showing them, which turns
# the footer's "reproduce the numbers" links into file-save dialogs. text/plain
# renders inline, and the bytes are identical either way.
/docs/*
  Content-Type: text/plain; charset=utf-8

/corpus/README.md
  Content-Type: text/plain; charset=utf-8

/LICENSE
  Content-Type: text/plain; charset=utf-8

/LICENSES.md
  Content-Type: text/plain; charset=utf-8

# YAML, and no browser has a type for .cff. Without this it downloads, which
# is a poor answer to someone who followed a "how to cite this" link.
/CITATION.cff
  Content-Type: text/plain; charset=utf-8

# The vendored tokenizer is content-addressed by its pinned version and never
# changes in place, so it can be cached hard.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
